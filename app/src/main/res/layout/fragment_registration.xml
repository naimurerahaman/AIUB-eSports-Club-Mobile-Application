<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackReg"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← Back"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="24dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Register"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fill in your details to join a tournament"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="32dp"/>

        <!-- ===== FORM FIELDS ===== -->

        <!-- Label for Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textSize="14sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Input field for Name -->
        <!-- EditText is a text box where users can type -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter your full name"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="20dp"/>

        <!-- Label for Student ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student ID"
            android:textSize="14sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Input field for Student ID -->
        <EditText
            android:id="@+id/etStudentId"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. 22-49123-1"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="20dp"/>

        <!-- Label for Team Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team Name"
            android:textSize="14sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Input field for Team Name -->
        <EditText
            android:id="@+id/etTeamName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter your team name"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="32dp"/>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅  Submit Registration"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="16dp"/>

        <!-- Success Message (hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="20dp"
            android:gravity="center"
            android:visibility="gone">
            <!-- "gone" means completely hidden and takes no space -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="48sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registration Successful!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvSuccessMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/light_gray"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>