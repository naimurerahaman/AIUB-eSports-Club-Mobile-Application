<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- LOADING STATE -->
    <LinearLayout
        android:id="@+id/layoutRegLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking registration status..."
            android:textColor="@color/light_gray"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- CLOSED STATE -->
    <LinearLayout
        android:id="@+id/layoutRegClosed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#128683;"
            android:textSize="64sp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registration Closed"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registration is closed now.\nWait for the next semester tournament."
            android:textSize="15sp"
            android:textColor="@color/light_gray"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="80dp"
            android:layout_height="3dp"
            android:background="@color/accent"/>

    </LinearLayout>

    <!-- OPEN STATE - REGISTRATION FORM -->
    <ScrollView
        android:id="@+id/layoutRegOpen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tournament Registration"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fill in all required fields to register"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/accent"
                android:layout_marginBottom="20dp"/>

            <!-- SECTION 1: BASIC INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Basic Information"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name *"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etRegName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter your full name"
                android:textColor="@color/white"
                android:textColorHint="@color/light_gray"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student ID *"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etRegStudentId"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="e.g. 22-49123-1"
                android:textColor="@color/white"
                android:textColorHint="@color/light_gray"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gender *"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="8dp"/>

            <!-- Gender — RadioGroup (only one gender) -->
            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Male"
                    android:textColor="@color/white"
                    android:buttonTint="@color/accent"/>

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Female"
                    android:textColor="@color/white"
                    android:buttonTint="@color/accent"/>

            </RadioGroup>

            <!-- SECTION 2: PLATFORM — CheckBox (multiple allowed) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferred Gaming Platform *"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select all platforms you play on"
                android:textSize="12sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cbPlatformPC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PC"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbPlatformMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mobile"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbPlatformConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Console"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <!-- SECTION 3: GAMES — CheckBox (multiple allowed) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Games for Upcoming Event *"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select all games you want to participate in"
                android:textSize="12sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cbValorant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Valorant"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbPUBG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PUBG"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbMLBB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MLBB (Mobile Legends)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbEAFC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EA FC"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbCS2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CS2"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbEFootball"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="eFootball"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbStreetFighter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Street Fighter"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Other"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <!-- SECTION 4: FORMAT — CheckBox (multiple allowed) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferred Tournament Format *"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select all formats you are comfortable with"
                android:textSize="12sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cbFormatSolo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solo (1 player)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbFormatDuo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Duo (2 players)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbFormatSquad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Squad (4-5 players)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <!-- SECTION 5: SUGGESTIONS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Suggestions (Optional)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Suggest additional event segments or ideas"
                android:textSize="12sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etSuggestions"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Write your suggestions here..."
                android:textColor="@color/white"
                android:textColorHint="@color/light_gray"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="28dp"/>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmitRegistration"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Submit Registration"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent"
                android:layout_marginBottom="12dp"/>

            <!-- Success Message -->
            <LinearLayout
                android:id="@+id/layoutRegSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="20dp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127881;"
                    android:textSize="48sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registration Submitted!"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We will contact you soon. Good luck!"
                    android:textSize="13sp"
                    android:textColor="@color/light_gray"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>