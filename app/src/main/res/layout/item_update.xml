<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Post Image (optional) -->
        <ImageView
            android:id="@+id/ivUpdateImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            android:scaleType="centerCrop"
            android:contentDescription="Update image"/>

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Club badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢  AIUB eSports Club"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <!-- Post Title -->
            <TextView
                android:id="@+id/tvUpdateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp"/>

            <!-- Post Description -->
            <TextView
                android:id="@+id/tvUpdateDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description text"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/light_gray"
                android:alpha="0.3"
                android:layout_marginBottom="10dp"/>

            <!-- Date -->
            <TextView
                android:id="@+id/tvUpdateDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕐 Just now"
                android:textSize="11sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="10dp"/>

            <!-- ===== NEW: Link Button ===== -->
            <!-- visibility="gone" by default -->
            <!-- Only shown when admin provides a link -->
            <Button
                android:id="@+id/btnUpdateLink"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔗  Visit Link"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_blue"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>