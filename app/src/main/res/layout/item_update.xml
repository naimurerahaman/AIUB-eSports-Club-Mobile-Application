<?xml version="1.0" encoding="utf-8"?>
<!-- This is the design for ONE update card in the feed -->
<!-- CardView gives us the nice rounded card with shadow effect -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== POST IMAGE (optional) ===== -->
        <!-- visibility="gone" by default — only shown if imageUrl is not empty -->
        <ImageView
            android:id="@+id/ivUpdateImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Update image"/>

        <!-- ===== TEXT CONTENT ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Club tag badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢  AIUB eSports Club"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <!-- Post Title -->
            <TextView
                android:id="@+id/tvUpdateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp"/>

            <!-- Post Description -->
            <TextView
                android:id="@+id/tvUpdateDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description text goes here"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp"/>

            <!-- Divider line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/light_gray"
                android:alpha="0.3"
                android:layout_marginBottom="10dp"/>

            <!-- Post Date/Time -->
            <TextView
                android:id="@+id/tvUpdateDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕐 Just now"
                android:textSize="11sp"
                android:textColor="@color/light_gray"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>