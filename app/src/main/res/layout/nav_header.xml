<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingTop="40dp"
    android:background="@color/accent_navy">

    <!-- Avatar -->
    <TextView
        android:id="@+id/tvNavAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="&#9889;"
        android:textSize="24sp"
        android:gravity="center"
        android:background="@color/accent_main"
        android:layout_marginBottom="10dp"/>

    <!-- User Name -->
    <TextView
        android:id="@+id/tvNavUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AIUB Gamer"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="2dp"/>

    <!-- User Email -->
    <TextView
        android:id="@+id/tvNavUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="user@aiub.edu"
        android:textSize="12sp"
        android:textColor="#CCCCCC"
        android:layout_marginBottom="14dp"/>

    <!-- Dark Mode Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#22FFFFFF"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvThemeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#127769;"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dark Mode"
            android:textSize="13sp"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDarkMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"/>

    </LinearLayout>

</LinearLayout>