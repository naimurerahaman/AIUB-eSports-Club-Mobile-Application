<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Close/Back button -->
        <Button
            android:id="@+id/btnCloseChatbot"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="✕"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginEnd="12dp"/>

        <!-- Bot avatar -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🤖"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@color/accent_blue"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="eSports Assistant"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <!-- Online indicator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online"
                android:textSize="11sp"
                android:textColor="#2ECC71"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== CHAT MESSAGES LIST ===== -->
    <!-- layout_weight="1" makes this take all available space -->
    <!-- leaving room for the input bar at the bottom -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- ===== INPUT BAR at bottom ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Text input where user types their message -->
        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Ask me anything..."
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/dark_bg"
            android:padding="12dp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:maxLines="1"
            android:layout_marginEnd="8dp"/>

        <!-- Send button -->
        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="➤"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:padding="0dp"/>

    </LinearLayout>

</LinearLayout>