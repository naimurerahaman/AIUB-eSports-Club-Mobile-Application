<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== BANNER IMAGE ===== -->
        <!-- Hidden by default — only shows if bannerImageUrl is not empty -->
        <ImageView
            android:id="@+id/ivEventBanner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Event banner"/>

        <!-- ===== EVENT CONTENT ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Game Icon + Event Name row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvEventIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="&#127918;"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@color/accent_blue"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEventName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Event Name"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/tvEventGame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Game"
                        android:textSize="12sp"
                        android:textColor="@color/accent"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Date -->
            <TextView
                android:id="@+id/tvEventDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="4dp"/>

            <!-- Prize -->
            <TextView
                android:id="@+id/tvEventPrize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prize"
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:layout_marginBottom="10dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tvEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/light_gray"
                android:alpha="0.3"
                android:layout_marginBottom="12dp"/>

            <!-- ===== ACTION BUTTONS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Register Button — only shown if registrationLink exists -->
                <Button
                    android:id="@+id/btnEventRegister"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Register Now"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/accent"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>

                <!-- Event Link Button — only shown if eventLink exists -->
                <Button
                    android:id="@+id/btnEventLink"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="View Event"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/accent_blue"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"/>

                <!-- View Details Button -->
                <Button
                    android:id="@+id/btnViewDetails"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="View Details"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/card_bg"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>