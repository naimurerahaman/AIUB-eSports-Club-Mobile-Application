<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== MAIN CONTENT (child 1 of DrawerLayout) ===== -->
    <!-- Using FrameLayout so FAB can float over the fragment -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg"
        android:fitsSystemWindows="true">

        <!-- Main vertical layout: Toolbar + Fragment container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Toolbar -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/card_bg"
                android:elevation="4dp"
                app:title="AIUB eSports Club"
                app:titleTextColor="@color/white"
                app:navigationIconTint="@color/white"/>

            <!-- Fragment Container -->
            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <!-- FAB sits INSIDE the FrameLayout so it floats over the fragment -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabChatbot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@android:drawable/ic_dialog_info"
            android:contentDescription="Open Chatbot"
            app:backgroundTint="@color/accent"
            app:tint="@color/white"
            app:fabSize="normal"
            app:elevation="8dp"/>

    </FrameLayout>

    <!-- ===== NAVIGATION DRAWER (child 2 of DrawerLayout) ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card_bg"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu"
        app:itemTextColor="@color/white"
        app:itemIconTint="@color/accent"/>

</androidx.drawerlayout.widget.DrawerLayout>