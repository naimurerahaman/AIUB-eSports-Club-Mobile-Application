<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackAddEvent"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← Back"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="20dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Add New Event"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="24dp"/>

        <!-- Event Name Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Name"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Event Name Input -->
        <EditText
            android:id="@+id/etEventName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. PUBG Tournament"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Game Name Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Game Name"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Game Name Input -->
        <EditText
            android:id="@+id/etGameName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. PUBG Mobile"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Date Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Date"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Date Input -->
        <EditText
            android:id="@+id/etEventDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. July 15, 2025"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Prize Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prize"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Prize Input -->
        <EditText
            android:id="@+id/etEventPrize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. BDT 10,000"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Description Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Description Input (multi-line) -->
        <EditText
            android:id="@+id/etEventDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Describe the event..."
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="28dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveEvent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="💾  Save Event to Firebase"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"/>

    </LinearLayout>
</ScrollView>