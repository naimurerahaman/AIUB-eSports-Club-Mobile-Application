<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- LOADING STATE -->
    <LinearLayout
        android:id="@+id/layoutMemberLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking recruitment status..."
            android:textColor="@color/light_gray"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- CLOSED STATE -->
    <LinearLayout
        android:id="@+id/layoutMemberClosed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#128683;"
            android:textSize="64sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recruitment Closed"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Membership recruitment is currently closed.\nPlease wait for the next recruitment session."
            android:textSize="15sp"
            android:textColor="@color/light_gray"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="80dp"
            android:layout_height="3dp"
            android:background="@color/accent"/>

    </LinearLayout>

    <!-- OPEN STATE - MEMBERSHIP FORM -->
    <ScrollView
        android:id="@+id/layoutMemberOpen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Become a AESC Member"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fill in all required fields to apply for membership"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/accent"
                android:layout_marginBottom="20dp"/>

            <!-- SECTION 1: BASIC INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Basic Information"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="14dp"/>

            <!-- Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name *"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etMemberName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter your full name"
                android:textColor="@color/white"
                android:textColorHint="@color/light_gray"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="14dp"/>

            <!-- Student ID -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student ID *"
                android:textSize="13sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etMemberStudentId"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="e.g. 22-49123-1"
                android:textColor="@color/white"
                android:textColorHint="@color/light_gray"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:inputType="text"
                android:layout_marginBottom="20dp"/>

            <!-- SECTION 2: DEPARTMENT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Department *"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="10dp"/>

            <!-- Spinner for department -->
            <Spinner
                android:id="@+id/spinnerDepartment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/card_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="20dp"/>

            <!-- SECTION 3: PLATFORM -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferred Platform *"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select all platforms you play on"
                android:textSize="12sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cbPlatformPC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PC"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbPlatformMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mobile"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <!-- SECTION 4: GAMES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Games You Play *"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select all games you play"
                android:textSize="12sp"
                android:textColor="@color/light_gray"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cbGameValorant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Valorant"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbGamePUBGM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PUBGM"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbGameFreeFire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FreeFire"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbGameEFootball"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="eFootball"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbGameMLBB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MLBB"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbGameCS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CS"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbGameEAFC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EAFC"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <!-- SECTION 5: ROLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Role *"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginBottom="10dp"/>

            <Spinner
                android:id="@+id/spinnerRole"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/card_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="28dp"/>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmitMembership"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Submit Application"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent"
                android:layout_marginBottom="12dp"/>

            <!-- Success Message -->
            <LinearLayout
                android:id="@+id/layoutMemberSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="20dp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127881;"
                    android:textSize="48sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Application Submitted!"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We will review your application and contact you soon!"
                    android:textSize="13sp"
                    android:textColor="@color/light_gray"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>