<?xml version="1.0" encoding="utf-8"?>
<!-- This is the design for ONE player card in the admin manage list -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Row 1: Avatar + Name + Rank -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Avatar circle — shows first letter of name -->
        <TextView
            android:id="@+id/tvAdminPlayerAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@color/accent"
            android:layout_marginEnd="12dp"/>

        <!-- Player Name -->
        <TextView
            android:id="@+id/tvAdminPlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Player Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <!-- Rank badge on the right -->
        <TextView
            android:id="@+id/tvAdminPlayerRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥇"
            android:textSize="22sp"/>

    </LinearLayout>

    <!-- Row 2: Game and Role info -->
    <TextView
        android:id="@+id/tvAdminPlayerDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Game  |  Role"
        android:textSize="13sp"
        android:textColor="@color/light_gray"
        android:layout_marginBottom="12dp"/>

    <!-- Row 3: Edit and Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Edit Button -->
        <Button
            android:id="@+id/btnEditPlayer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="✏️ Edit"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginEnd="8dp"/>

        <!-- Delete Button -->
        <Button
            android:id="@+id/btnDeletePlayer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🗑️ Delete"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:backgroundTint="#C0392B"/>

    </LinearLayout>
</LinearLayout>