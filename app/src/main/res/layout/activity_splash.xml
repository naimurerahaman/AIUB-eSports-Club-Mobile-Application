<?xml version="1.0" encoding="utf-8"?>
<!-- ConstraintLayout lets us position items freely anywhere on screen -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- ===== CENTER CONTENT ===== -->
    <LinearLayout
        android:id="@+id/layoutSplashCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Logo -->
        <!-- alpha="0" makes it invisible at start — animation fades it in -->
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/esports_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp"
            android:contentDescription="AIUB eSports Club Logo"/>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AIUB eSports Club"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Slogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compete. Connect. Conquer."
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Divider line -->
        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:background="@color/accent"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>

    <!-- ===== BOTTOM LOADING TEXT ===== -->
    <LinearLayout
        android:id="@+id/layoutSplashBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Loading dots / status text -->
        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="8dp"/>

        <!-- Small progress bar -->
        <ProgressBar
            android:id="@+id/progressBarSplash"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:progressBackgroundTint="@color/card_bg"/>

    </LinearLayout>

    <!-- ===== VERSION TEXT ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0"
        android:textSize="11sp"
        android:textColor="@color/light_gray"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>