<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackAddEvent"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Back"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="20dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Event"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="24dp"/>

        <!-- ===== BANNER IMAGE URL ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Banner Image URL (Optional)"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste any image link from Google or web"
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etBannerUrl"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="https://example.com/image.jpg"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="textUri"
            android:layout_marginBottom="8dp"/>

        <!-- Preview button -->
        <Button
            android:id="@+id/btnPreviewBanner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Preview Image"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="8dp"/>

        <!-- Image preview -->
        <ImageView
            android:id="@+id/ivBannerPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginBottom="20dp"
            android:contentDescription="Banner preview"/>

        <!-- ===== EVENT NAME ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Title *"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEventName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. PUBG Championship 2025"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- ===== DESCRIPTION ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Description *"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEventDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Describe the event in detail..."
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="16dp"/>

        <!-- ===== DATE ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Date *"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <!-- Date picker row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etEventDate"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:hint="Select a date"
                android:textColor="@color/white"
                android:textColorHint="@color/light_gray"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Pick"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent"/>

        </LinearLayout>

        <!-- ===== PRIZE ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prize *"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEventPrize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. BDT 10,000"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- ===== GAME NAME ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Game Name *"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etGameName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. PUBG Mobile"
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- ===== REGISTRATION LINK ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registration Link *"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Users will tap this to register for the event"
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etRegistrationLink"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="https://forms.google.com/..."
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp"/>

        <!-- ===== EVENT LINK ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Link (Optional)"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Facebook event, Discord, or tournament page"
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEventLink"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="https://facebook.com/events/..."
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="textUri"
            android:layout_marginBottom="28dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveEvent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Event"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"/>

        <!-- Saving progress bar -->
        <ProgressBar
            android:id="@+id/progressSaveEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>