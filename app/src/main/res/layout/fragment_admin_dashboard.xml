<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Admin Dashboard"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <Button
                android:id="@+id/btnAdminLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Logout"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="#555555"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AIUB eSports Club Management"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="24dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent"
            android:layout_marginBottom="24dp"/>

        <!-- ===== ANALYTICS BUTTON ===== -->
        <Button
            android:id="@+id/btnViewAnalytics"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Analytics Dashboard"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="#2C3E50"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent"
            android:layout_marginBottom="24dp"/>

        <!-- ===== REGISTRATION CONTROL ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTRATION CONTROL"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_marginBottom="10dp"/>

        <!-- Status Card with Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/card_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Loading spinner -->
            <ProgressBar
                android:id="@+id/progressRegStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:visibility="visible"/>

            <!-- Status text -->
            <TextView
                android:id="@+id/tvRegStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Checking status..."
                android:textSize="14sp"
                android:textColor="@color/white"/>

            <!-- Toggle Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRegOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toggle ON to open registration. Toggle OFF to close it."
            android:textSize="11sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnViewRegistrations"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="View Registrations"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="24dp"/>
        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="24dp"/>
        <!-- ===== RECRUITMENT CONTROL ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MEMBERSHIP RECRUITMENT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/card_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ProgressBar
                android:id="@+id/progressRecruitStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/tvRecruitStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Checking status..."
                android:textSize="14sp"
                android:textColor="@color/white"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRecruitOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toggle ON to open recruitment. Toggle OFF to close it."
            android:textSize="11sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnViewMemberApplications"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="View Member Applications"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="24dp"/>

        <!-- ===== UPDATES MANAGEMENT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPDATES MANAGEMENT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCreateUpdate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Create New Update / Post"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnManageUpdates"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Manage Updates (Edit / Delete)"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="28dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="24dp"/>

        <!-- ===== EVENT MANAGEMENT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EVENT MANAGEMENT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Add New Event"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnManageEvents"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Manage Events (Edit / Delete)"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="28dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="24dp"/>

        <!-- ===== PLAYER MANAGEMENT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAYER MANAGEMENT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAddPlayer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Add New Player"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnManagePlayers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Manage Players (Edit / Delete)"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="28dp"/>

    </LinearLayout>
</ScrollView>