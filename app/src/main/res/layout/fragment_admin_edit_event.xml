<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBackEdit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← Back"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ Edit Event"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Name"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEditEventName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="@color/white"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Game Name"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEditGameName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="@color/white"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Date"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEditEventDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="@color/white"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prize"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEditEventPrize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="@color/white"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEditEventDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:textColor="@color/white"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="28dp"/>
        <!-- Banner Image URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Banner Image URL (Optional)"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEditBannerUrl"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="https://raw.githubusercontent.com/..."
            android:textColor="@color/white"
            android:textColorHint="@color/light_gray"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:inputType="textUri"
            android:layout_marginBottom="14dp"/>

        <!-- Preview Button -->
        <Button
            android:id="@+id/btnPreviewEditBanner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Preview Image"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="8dp"/>

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/ivEditBannerPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginBottom="14dp"
            android:contentDescription="Banner preview"/>

        <Button
            android:id="@+id/btnUpdateEvent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅  Update Event"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"/>

    </LinearLayout>
</ScrollView>