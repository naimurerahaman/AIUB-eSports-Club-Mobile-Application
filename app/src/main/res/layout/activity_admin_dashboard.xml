<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡️ Admin Dashboard"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <!-- Logout button top right -->
            <Button
                android:id="@+id/btnAdminLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Logout"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="#555555"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AIUB eSports Club Management"
            android:textSize="13sp"
            android:textColor="@color/light_gray"
            android:layout_marginBottom="28dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent"
            android:layout_marginBottom="28dp"/>

        <!-- ===== EVENTS SECTION ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅  EVENT MANAGEMENT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_marginBottom="12dp"/>

        <!-- Add Event -->
        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="➕  Add New Event"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="12dp"/>

        <!-- Manage Events (View, Edit, Delete) -->
        <Button
            android:id="@+id/btnManageEvents"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚙️  Manage Events (Edit / Delete)"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="28dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="28dp"/>

        <!-- ===== PLAYERS SECTION ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥  PLAYER MANAGEMENT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_marginBottom="12dp"/>

        <!-- Add Player -->
        <Button
            android:id="@+id/btnAddPlayer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="➕  Add New Player"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="12dp"/>

        <!-- Manage Players -->
        <Button
            android:id="@+id/btnManagePlayers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚙️  Manage Players (Edit / Delete)"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="28dp"/>

    </LinearLayout>
</ScrollView>