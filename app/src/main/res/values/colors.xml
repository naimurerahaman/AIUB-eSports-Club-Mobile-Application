    <color name="dark_bg">#0D0D0D</color>

    <!-- This is a slightly lighter dark color for cards -->
    <color name="card_bg">#1A1A2E</color>

    <!-- This is the glowing purple/blue accent color -->
    <color name="accent">#E94560</color>

    <!-- A second accent color for highlights -->
