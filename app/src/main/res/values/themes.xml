<resources>
    <style name="Theme.AIUBeSportsClub"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/accent_main</item>
        <item name="colorPrimaryVariant">@color/accent_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:statusBarColor">@color/card_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- DO NOT add fitsSystemWindows here — it breaks layouts -->

    </style>

    <style name="Theme.AIUBeSportsClub.Splash"
        parent="Theme.AIUBeSportsClub">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
    </style>

</resources>