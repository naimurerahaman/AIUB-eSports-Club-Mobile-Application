<resources>


    <style name="Theme.AIUBeSportsClub"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_main</item>
        <item name="colorPrimaryVariant">@color/accent_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/accent_main</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <!-- ===== SPLASH SCREEN THEME ===== -->
    <!-- This theme hides the title bar and makes it full screen -->
    <!-- We apply this ONLY to SplashActivity -->
    <style name="Theme.AIUBeSportsClub.Splash"
        parent="Theme.AIUBeSportsClub">

        <!-- Hide the top action bar on splash screen -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Make status bar same color as splash background -->
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>

    </style>

</resources>