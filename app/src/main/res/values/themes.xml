<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- This defines the overall look and feel of the entire app -->
    <style name="Theme.AIUBeSportsClub" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary color (used by Android system automatically) -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Background of all screens -->
        <item name="android:windowBackground">@color/dark_bg</item>

        <!-- Status bar at the top of the phone -->
        <item name="android:statusBarColor">@color/dark_bg</item>

    </style>

</resources>