<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission — needed for FCM -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- POST_NOTIFICATIONS permission — required for Android 13+ -->
    <!-- Without this, notifications won't show on newer phones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIUBeSportsClub">

        <!-- ===== SPLASH — Opens first ===== -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AIUBeSportsClub.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== ENTRY ACTIVITIES ===== -->
        <activity android:name=".LoginActivity"          android:exported="false" />
        <activity android:name=".SignupActivity"         android:exported="false" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".AdminLoginActivity"     android:exported="false" />

        <!-- ===== FRAGMENT HOST ACTIVITIES ===== -->
        <activity android:name=".MainActivity"  android:exported="false" />
        <activity android:name=".AdminActivity" android:exported="false" />

        <!-- ===== FIREBASE MESSAGING SERVICE ===== -->
        <!-- This is the service that receives notifications -->
        <!-- android:exported="false" means only our app can start it -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <!-- This tells Android: use this service for FCM messages -->
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>